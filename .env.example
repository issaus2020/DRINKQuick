# Zugangsdaten des Supabase-Projekts für Konto und geteilten Familien-Bereich.
#
# Ohne diese beiden Werte läuft die App rein lokal: kein Konto, kein Server,
# alle Daten bleiben auf dem Gerät. Das ist ein gültiger Zustand, kein Fehler.
#
# WO ZU FINDEN
#   URL:        Supabase-Dashboard -> Settings -> Data API
#   Schlüssel:  Supabase-Dashboard -> Settings -> API Keys
#               Neue Projekte: Reiter "Publishable and secret API keys",
#                              dort den Publishable key (sb_publishable_...).
#               Ältere Projekte: Reiter "Legacy API keys", dort den anon key.
#               Beide funktionieren; nimm den, den dein Projekt anzeigt.
#
# NIEMALS den secret key (sb_secret_...) bzw. service_role hier eintragen.
# Der hebelt den Zugriffsschutz komplett aus, und im Browser ist jeder Wert
# einsehbar. Der publishable/anon key dagegen darf öffentlich sein: der Schutz
# steckt in den Row-Level-Security-Regeln (supabase/schema.sql), nicht in der
# Geheimhaltung des Schlüssels.
#
# Für die Veröffentlichung auf Vercel gehören dieselben zwei Werte unter
# Project Settings -> Environment Variables. Danach neu deployen - Vite backt
# sie beim Bauen ein, gespeicherte Variablen allein ändern die fertige Seite
# nicht.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_dein_schluessel
